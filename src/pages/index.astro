---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ServiceRibbon from '../components/ServiceRibbon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PackageCard from '../components/PackageCard.astro';
import TrialBanner from '../components/TrialBanner.astro';
import FirstVisitSteps from '../components/FirstVisitSteps.astro';
import Reviews from '../components/Reviews.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, inCity } from '../config/site.ts';
import { servicePages } from '../data/service-pages.ts';
import { packages, minPrice, services, minPackagePrice } from '../data/catalog.ts';
import { faq } from '../data/faq.ts';
import { formatPrice } from '../lib/format.ts';
import { fitDescription } from '../lib/seo.ts';

const title = `${SITE.name} — аппаратная коррекция фигуры${inCity()}`;
const description = fitDescription(
  `Студия «${SITE.name}»${inCity()}: LPG и Sketch массаж, RF лифтинг, УЗ кавитация, прессотерапия. Процедуры от ${formatPrice(minPrice(services))}, курсы от ${formatPrice(minPackagePrice())}. Консультация перед курсом.`,
);
const complexes = packages.filter((p) => p.kind === 'complex');
---
<Base home title={title} description={description}>
  <Hero
    title="Ваше тело. Ваш комфорт."
    lead="Аппаратная коррекция фигуры в Архангельске. Подберём процедуры под ваши цели и составим курс после консультации."
  />
  <ServiceRibbon />

  <section class="section container home-services" aria-labelledby="services-title">
    <div class="section-intro"><p class="editorial-label">01 / Процедуры</p><p>Разные технологии.<br />Один подход — внимание к вам.</p></div>
    <h2 id="services-title">Найдите свою<br />точку равновесия.</h2>
    <div class="cards">
      {servicePages.map((p) => <ServiceCard page={p} />)}
    </div>
    <p><a href="/ceny/">Полный прайс-лист</a></p>
  </section>

  <div class="sunlit-band sunlit-band--peach"><div class="container"><TrialBanner /></div></div>

  <section class="section container home-complexes" aria-labelledby="complexes-title">
    <p class="editorial-label">02 / Комплексный подход</p>
    <h2 id="complexes-title">Забота, которая<br />складывается в систему.</h2>
    <div class="cards">
      {complexes.map((p) => <PackageCard pkg={p} />)}
    </div>
    <p><a href="/abonementy/">Все комплексы и курсы</a></p>
  </section>

  <div class="sunlit-band sunlit-band--yellow"><div class="container"><p class="editorial-label">03 / Знакомство со студией</p><FirstVisitSteps /></div></div>

  <div class="section container"><Reviews limit={3} /></div>

  <div class="section container">
    <FaqAccordion items={faq.slice(0, 4)} title="Частые вопросы" id="home-faq" />
    <p><a href="/faq/">Все вопросы и противопоказания</a></p>
  </div>

  <div class="sunlit-band sunlit-band--sand"><div class="container"><LeadForm /></div></div>

  <CtaBand />
</Base>
