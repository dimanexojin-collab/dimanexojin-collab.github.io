---
import { Picture } from 'astro:assets';
import figure from '../assets/logo/figure.png';
import { SITE, isTodo, bookingHref } from '../config/site.ts';
import { mainNav, isActive } from '../lib/nav.ts';
import Icon from './Icon.astro';
import MobileNav from './MobileNav.astro';
import ProcedureMenu from './ProcedureMenu.astro';

const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : isActive(href, path) ? 'true' : undefined);
---
<header class="site-header">
  <div class="site-header__inner container">
    <a class="logo" href="/" title="На главную">
      <Picture src={figure} formats={['avif', 'webp']} width={36} densities={[1, 2]} alt="" loading="eager" />
      <span class="logo__text">
        <span class="logo__name">{SITE.name}</span>
        <span class="logo__tagline">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="Основная навигация">
      <ul>
        {mainNav.map((item) => (
          <li class:list={{ 'has-children': !!item.children }}>
            {item.children ? (
              <details class="nav-dropdown" data-nav-dropdown>
                <summary class="nav-summary" aria-current={current(item.href)}>
                  {item.label}
                  <svg viewBox="0 0 16 16" aria-hidden="true" fill="none"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </summary>
                <div class="submenu">
                  <div class="submenu__heading">Выберите процедуру</div>
                  <ProcedureMenu preview />
                </div>
              </details>
            ) : <a href={item.href} aria-current={current(item.href)}>{item.label}</a>}

          </li>
        ))}
      </ul>
    </nav>

    <div class="header-contacts">
      <a class="header-contacts__phone" href={SITE.phoneHref}>
        <span class:list={[{ todo: isTodo(SITE.phone) }]}>{SITE.phone}</span>
      </a>
      <a href={SITE.vk} target="_blank" rel="noopener" aria-label="Мы во ВКонтакте"><Icon name="vk" /></a>
      <a class="btn btn--primary" href={bookingHref()}>Записаться</a>
    </div>

    <MobileNav />
  </div>
</header>

<script>
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-nav-dropdown], .mobile-nav')];
  document.addEventListener('click', (event) => {
    for (const menu of menus) {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    }
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    for (const menu of menus) {
      if (!menu.open) continue;
      menu.open = false;
      menu.querySelector<HTMLElement>('summary')?.focus();
    }
  });
  matchMedia('(min-width: 1180px)').addEventListener('change', () => {
    for (const menu of menus) menu.open = false;
  });
</script>
