---
import { SITE, isTodo } from '../config/site.ts';
import Icon from './Icon.astro';

interface Props {
  /** Предзаполненный текст для WhatsApp */
  message?: string;
  /** Показывать кнопку телефона */
  phone?: boolean;
  class?: string;
}
const { message, phone = true, class: cls } = Astro.props;
---
<div class:list={['contact-buttons', cls]}>
  {phone && (
    <a class="btn contact-buttons__phone" href={SITE.phoneHref}>
      <Icon name="phone" /> <span class:list={[{ todo: isTodo(SITE.phone) }]}>{SITE.phone}</span>
    </a>
  )}
  <a class="btn contact-buttons__vk" href={SITE.vk} target="_blank" rel="noopener">
    <Icon name="vk" /> ВКонтакте
  </a>
</div>
