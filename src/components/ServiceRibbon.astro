---
/**
 * Лента процедур под hero. Без JS / при reduced-motion — горизонтальный скролл со snap.
 * С JS (scripts/motion.ts) — бесконечная 3D-карусель: rotateY/scale/blur/opacity по позиции плитки.
 * Иконки — плоские «стеклянные» SVG: белый диск, серебряные кольца, графитовый знак. Без градиентов.
 */
import { servicePages } from '../data/service-pages.ts';

// Знак каждой процедуры (viewBox 0 0 64 64, рисуется поверх диска)
const glyphs: Record<string, string> = {
  'lpg-massazh': '<circle cx="23" cy="32" r="7"/><circle cx="41" cy="32" r="7"/><path d="M16 45c5 3 27 3 32 0"/>',
  'sketch-massazh': '<path d="M17 38c5-10 9-10 12 0s7 10 12 0 6-8 7-6"/><path d="M17 28c5-8 9-8 12 0"/>',
  'rf-lifting': '<circle cx="32" cy="34" r="3.5" fill="currentColor"/><path d="M24 26a11 11 0 0 1 16 0M19 21a18 18 0 0 1 26 0M24 42a11 11 0 0 0 16 0"/>',
  kavitaciya: '<circle cx="26" cy="36" r="7"/><circle cx="39" cy="25" r="5"/><circle cx="41" cy="40" r="3"/><circle cx="24" cy="21" r="2.5"/>',
  'vakuumnyj-massazh': '<path d="M24 20h16l-3 9a10 10 0 1 1-10 0z"/><path d="M28 16h8"/>',
  pressoterapiya: '<path d="M26 16h12l-2 34h-8z"/><path d="M26 24h12M26.5 32h11M27 40h10"/>',
  vibromassazh: '<path d="M14 32h6l3-9 5 18 5-18 5 18 3-9h9"/>',
  'lazernyj-lipoliz': '<path d="M32 15c1 10 6 15 17 17-11 2-16 7-17 17-1-10-6-15-17-17 11-2 16-7 17-17z"/>',
  biofoton: '<circle cx="32" cy="32" r="7"/><path d="M32 16v5M32 43v5M16 32h5M43 32h5M20.7 20.7l3.6 3.6M39.7 39.7l3.6 3.6M20.7 43.3l3.6-3.6M39.7 24.3l3.6-3.6"/>',
};
const fallback = '<circle cx="32" cy="32" r="8"/>';
---
<section class="ribbon container" aria-label="Процедуры студии">
  <ul class="ribbon__track" data-ribbon>
    {servicePages.map((p) => (
      <li>
        <a class="tile" href={`/uslugi/${p.slug}/`}>
          <svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
            <circle cx="32" cy="32" r="29" fill="#fff" stroke="#B9B9BE" stroke-width="1.5" />
            <circle cx="32" cy="32" r="23" fill="#ECEAE7" stroke="#fff" stroke-width="2" />
            <g fill="none" stroke="#2A2A2E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={glyphs[p.slug] ?? fallback} />
          </svg>
          <span>{p.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
