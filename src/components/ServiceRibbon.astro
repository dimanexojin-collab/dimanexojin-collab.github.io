---
/** Native horizontal scrolling with touch inertia, desktop drag and a smooth position control. */
import { servicePages } from '../data/service-pages.ts';
import ProcedureIcon from './ProcedureIcon.astro';

// Знак каждой процедуры (viewBox 0 0 64 64, рисуется поверх диска)
---
<section class="ribbon container" aria-label="Процедуры студии">
  <ul class="ribbon__track" id="services-ribbon" data-ribbon tabindex="0" aria-label="Список процедур">
    {servicePages.map((p) => (
      <li>
        <a class="tile" href={`/uslugi/${p.slug}/`}>
          <ProcedureIcon slug={p.slug} />
          <span>{p.name}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="ribbon__controls" data-ribbon-controls hidden>
    <label class="ribbon__hint" for="services-position">Листайте процедуры</label>
    <input
      class="ribbon__range"
      id="services-position"
      data-ribbon-position
      type="range"
      min="0"
      max="1000"
      step="1"
      value="0"
      aria-label="Прокрутить список процедур"
      aria-controls="services-ribbon"
    />
  </div>
</section>

<script>
  import '../scripts/ribbon.ts';
</script>
