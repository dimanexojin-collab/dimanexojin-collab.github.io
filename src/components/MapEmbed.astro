---
import { SITE, filled, geoFilled } from '../config/site.ts';

const mapsUrl = filled(SITE.yandexMapsUrl);
const twoGis = filled(SITE.twoGisUrl);
const geo = geoFilled();
const params = geo ? new URLSearchParams({
  ll: `${geo.lon},${geo.lat}`,
  pt: `${geo.lon},${geo.lat},pm2rdm`,
  z: '17',
  l: 'map',
  lang: 'ru_RU',
}) : undefined;
const widget = filled(SITE.yandexMapWidget)
  ?? (params ? `https://yandex.ru/map-widget/v1/?${params}` : undefined);
---
<div class="map-embed">
  {widget && (
    <iframe
      class="map-embed__preview"
      src={widget}
      title={`Карта проезда: ${SITE.name}, ${SITE.address.locality}, ${SITE.address.street}`}
      width="100%"
      height="360"
      loading="lazy"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
    />
  )}
  <div class="map-embed__links" aria-label="Открыть маршрут в картах">
    {twoGis && <a class="btn" href={twoGis} target="_blank" rel="noopener noreferrer">Открыть в 2ГИС</a>}
    {mapsUrl && <a href={mapsUrl} target="_blank" rel="noopener noreferrer">Открыть в Яндекс Картах</a>}
  </div>
</div>
