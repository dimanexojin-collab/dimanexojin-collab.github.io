---
/**
 * Яндекс.Карта: до клика — заглушка-кнопка, iframe грузится только по клику (не влияет на LCP).
 * SITE.yandexMapWidget — src iframe из конструктора карт; пока TODO — показываем ссылку/текст.
 */
import { SITE, filled } from '../config/site.ts';

const widget = filled(SITE.yandexMapWidget);
const mapsUrl = filled(SITE.yandexMapsUrl);
---
<div class="map-embed" data-map-src={widget}>
  {widget ? (
    <button type="button" class="btn" data-map-load>Показать карту</button>
  ) : (
    <p class="todo">Карта появится после уточнения адреса студии.</p>
  )}
  {mapsUrl && <a href={mapsUrl} target="_blank" rel="noopener">Открыть в Яндекс Картах</a>}
</div>

<script>
    for (const box of document.querySelectorAll<HTMLElement>('[data-map-src]')) {
      if (!box.dataset.mapSrc) continue;
      box.querySelector('[data-map-load]')?.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = box.dataset.mapSrc!;
        iframe.title = 'Карта проезда';
        iframe.width = '100%';
        iframe.height = '400';
        iframe.loading = 'lazy';
        iframe.style.border = '0';
        box.replaceChildren(iframe);
      }, { once: true });
    }
</script>
