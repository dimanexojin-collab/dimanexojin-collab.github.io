---
import { Picture } from 'astro:assets';
import ballerina from '../assets/hero/ballerina-cutout.png';
import { bookingHref, SITE } from '../config/site.ts';
import Icon from './Icon.astro';
interface Props { title: string; lead: string; }
const { title, lead } = Astro.props;
---
<section class="sunlit-hero" aria-labelledby="hero-title">
  <div class="sunlit-hero__room" aria-hidden="true"></div>
  <svg class="sunlit-hero__orbits" viewBox="0 0 600 600" fill="none" aria-hidden="true"><g><ellipse cx="300" cy="300" rx="205" ry="275" transform="rotate(-25 300 300)" /><ellipse cx="300" cy="300" rx="250" ry="205" transform="rotate(28 300 300)" /><circle cx="214" cy="55" r="3" /><circle cx="537" cy="342" r="2.5" /></g></svg>
  <div class="container sunlit-hero__inner">
    <p class="sunlit-hero__eyebrow">Студия заботы о теле <span>{SITE.city} / Московский проспект, 33</span></p>
    <div class="sunlit-hero__wordmark" aria-hidden="true">КОНТУР</div>
    <div class="sunlit-hero__object">
      <Picture src={ballerina} formats={['avif', 'webp']} widths={[238, 476]} sizes="(min-width: 768px) 340px, 210px" alt="Скульптурная фигура балерины — символ студии «Контур»" loading="eager" fetchpriority="high" />
    </div>
    <div class="sunlit-hero__copy">
      <h1 id="hero-title">{title}</h1>
      <a class="btn btn--primary" href={bookingHref()}>Начать с консультации <Icon name="arrow" size={16} /></a>
    </div>
    <div class="sunlit-hero__note"><span class="editorial-label">В вашем ритме</span><p>{lead}</p><a href="#services-title">Найти свою процедуру <span aria-hidden="true">↓</span></a></div>
    <div class="sunlit-hero__foot"><span>Технологии. Прикосновение. Забота.</span><span>Листайте, чтобы познакомиться ↓</span></div>
  </div>
</section>
