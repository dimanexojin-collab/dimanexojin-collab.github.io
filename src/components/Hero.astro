---
import { Picture } from 'astro:assets';
// Фигура без фона (scripts/cutout-hero.mjs); исходник с фоном — ballerina.png
import ballerina from '../assets/hero/ballerina-cutout.png';
import { bookingHref } from '../config/site.ts';
import { trialPromo } from '../data/promos.ts';
import { getServicePage } from '../data/service-pages.ts';
import { formatPrice } from '../lib/format.ts';
import Icon from './Icon.astro';

interface Props {
  title: string;
  lead: string;
}
const { title, lead } = Astro.props;

/** Текст → слова в <span class="w"> (для анимации blur→sharp); пробелы остаются текстом. */
const words = (s: string) => s.split(' ').filter(Boolean);
const titleWords = words(title);
const leadWords = words(lead);
// Разброс задержек лида ≤ 80 мс — вход всего hero укладывается в ~600 мс
const leadStep = `${Math.max(2, Math.round(80 / Math.max(1, leadWords.length - 1)))}ms`;

// Ротатор: названия реальных страниц услуг (первое — в HTML, остальные подставляет JS)
const rotNames = ['lpg-massazh', 'rf-lifting', 'kavitaciya', 'pressoterapiya', 'sketch-massazh']
  .map((slug) => getServicePage(slug)?.name)
  .filter((n): n is string => !!n);
---
<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__text">
    <h1 id="hero-title">{titleWords.map((w, i) => <Fragment><span class="w" style={`--i:${i}`}>{w}</span>{i < titleWords.length - 1 && ' '}</Fragment>)}</h1>
    <p class="lead" style={`--st:${leadStep}`}>{leadWords.map((w, i) => <Fragment><span class="w" style={`--i:${i}`}>{w}</span>{i < leadWords.length - 1 && ' '}</Fragment>)}</p>
    {rotNames.length > 0 && (
      <p class="hero__rot">
        Процедуры студии:
        <span class="rot" data-rot={rotNames.join('|')}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7z" /></svg>
          <span class="rot__t">{rotNames[0]}</span>
        </span>
      </p>
    )}
    <div class="hero__actions">
      <a class="btn btn--primary" href={bookingHref()} data-magnetic>Записаться <Icon name="arrow" size={16} /></a>
      {trialPromo && <a class="btn" href="/akcii/"><span class="pulse" aria-hidden="true"></span>Пробный LPG за {formatPrice(trialPromo.price)}</a>}
    </div>
  </div>
  <div class="hero__media">
    <Picture
      src={ballerina}
      formats={['avif', 'webp']}
      widths={[146, 238]}
      sizes="(min-width: 768px) 238px, 146px"
      alt="Силуэт балерины — символ студии «Контур»"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
