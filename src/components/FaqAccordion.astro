---
/** FAQ на нативных <details>/<summary>. JSON-LD FAQPage добавляет страница (schema.faqPage). */
import type { FaqItem } from '../data/faq.ts';

interface Props {
  items: FaqItem[];
  title?: string;
  id?: string;
}
const { items, title, id = 'faq' } = Astro.props;
---
<section class="faq" id={id} aria-labelledby={title ? `${id}-title` : undefined} aria-label={title ? undefined : 'Вопросы и ответы'}>
  {title && <h2 id={`${id}-title`}>{title}</h2>}
  {items.map((f) => (
    <details class="faq__item">
      <summary class="faq__q">{f.q}</summary>
      <div class="faq__a"><p>{f.a}</p></div>
    </details>
  ))}
</section>
