---
import type { JsonLd } from '../lib/schema.ts';

interface Props {
  data: (JsonLd | null | undefined)[];
}

// Экранируем `<`, чтобы строка в JSON не могла закрыть <script>.
const items = Astro.props.data.filter(Boolean).map((d) => JSON.stringify(d).replace(/</g, '\\u003c'));
---
{items.map((json) => <script type="application/ld+json" set:html={json} />)}
