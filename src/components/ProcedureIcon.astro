---
import { serviceGlyphs } from '../data/service-icons.ts';
interface Props { slug: string }
const { slug } = Astro.props;
---
<svg viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <circle cx="32" cy="32" r="29" fill="#fff" stroke="#B9B9BE" stroke-width="1.5" />
  <circle cx="32" cy="32" r="23" fill="#ECEAE7" stroke="#fff" stroke-width="2" />
  <g fill="none" stroke="#2A2A2E" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={serviceGlyphs[slug] ?? '<circle cx="32" cy="32" r="8"/>'} />
</svg>
