---
import type { Crumb } from '../lib/schema.ts';

interface Props {
  /** Полная цепочка, начиная с главной */
  items: Crumb[];
}
const { items } = Astro.props;
---
<nav class="breadcrumbs container" aria-label="Хлебные крошки">
  <ol>
    {items.map((c, i) =>
      i === items.length - 1 ? (
        <li aria-current="page">{c.name}</li>
      ) : (
        <li><a href={c.href}>{c.name}</a></li>
      ),
    )}
  </ol>
</nav>
